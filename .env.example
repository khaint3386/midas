# Sao chép thành .env và điền giá trị thật. KHÔNG commit .env lên git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Đặt =1 để chạy demo với dữ liệu tổng hợp (không cần mạng/vnstock)
MIDAS_DEMO=0

# Cảnh báo Telegram khi có tín hiệu MUA mới (tùy chọn — để trống thì chạy dry-run,
# chỉ log ra console, không gửi thật). Lấy token qua @BotFather, lấy chat_id bằng
# cách nhắn bot rồi mở https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
